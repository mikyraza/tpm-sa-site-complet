{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "layout": {
            "contentSize": "100%",
            "wideSize": "100%"
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true,
            "customSpacingSize": true,
            "spacingScale": {
                "steps": 0
            }
        },
        "appearanceTools": false,
        "useRootPaddingAwareAlignments": false
    },
    "styles": {
        "spacing": {
            "blockGap": "0",
            "margin": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            },
            "padding": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            }
        },
        "blocks": {
            "core/group": {
                "spacing": {
                    "margin": { "top": "0", "bottom": "0" },
                    "padding": { "top": "0", "bottom": "0" }
                }
            }
        }
    }
}
